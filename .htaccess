# Compatibility entry point when the hosting document root points to the
# CodeIgniter project directory instead of directly to the public directory.
Options -Indexes

# Compress text assets. Brotli is preferred when the hosting module is present;
# DEFLATE remains the safe fallback for standard Apache installations.
<IfModule mod_brotli.c>
    AddOutputFilterByType BROTLI_COMPRESS text/html text/plain text/css text/javascript application/javascript application/json application/xml image/svg+xml font/woff2
</IfModule>
<IfModule !mod_brotli.c>
    <IfModule mod_deflate.c>
        AddOutputFilterByType DEFLATE text/html text/plain text/css text/javascript application/javascript application/json application/xml image/svg+xml font/woff2
    </IfModule>
</IfModule>

<IfModule mod_expires.c>
    ExpiresActive On
    ExpiresByType text/css "access plus 1 year"
    ExpiresByType text/javascript "access plus 1 year"
    ExpiresByType application/javascript "access plus 1 year"
    ExpiresByType image/avif "access plus 1 month"
    ExpiresByType image/webp "access plus 1 month"
    ExpiresByType image/png "access plus 1 month"
    ExpiresByType image/jpeg "access plus 1 month"
    ExpiresByType image/svg+xml "access plus 1 month"
    ExpiresByType image/x-icon "access plus 1 month"
    ExpiresByType font/woff2 "access plus 1 year"
</IfModule>

<IfModule mod_headers.c>
    <FilesMatch "\.(?:css|js|woff2)$">
        Header set Cache-Control "public, max-age=31536000, immutable"
    </FilesMatch>
    <FilesMatch "\.(?:avif|webp|png|jpe?g|svg|ico)$">
        Header set Cache-Control "public, max-age=2592000"
    </FilesMatch>
    Header merge Vary "Accept-Encoding"
</IfModule>

# Serve pre-compressed CSS/JS when the host does not provide a compression
# module. This keeps compression available on minimal shared-hosting setups.
<IfModule !mod_brotli.c>
    <IfModule !mod_deflate.c>
        <IfModule mod_rewrite.c>
            RewriteCond %{HTTP:Accept-Encoding} gzip
            RewriteCond %{REQUEST_FILENAME}.gz -f
            RewriteRule ^(.+\.(?:css|js))$ $1.gz [L]
        </IfModule>
    </IfModule>
</IfModule>

<IfModule mod_headers.c>
    <FilesMatch "\.css\.gz$">
        ForceType text/css
        Header set Content-Encoding gzip
        Header set Cache-Control "public, max-age=31536000, immutable"
    </FilesMatch>
    <FilesMatch "\.js\.gz$">
        ForceType application/javascript
        Header set Content-Encoding gzip
        Header set Cache-Control "public, max-age=31536000, immutable"
    </FilesMatch>
</IfModule>

<IfModule mod_rewrite.c>
    RewriteEngine On

    # Keep hosting certificate validation reachable.
    RewriteRule ^\.well-known(?:/|$) - [L]

    # Never expose application source, runtime data, dependencies, or secrets.
    RewriteRule ^(?:app|system|tests|writable|vendor|\.git)(?:/|$) - [F,L,NC]
    RewriteRule ^(?:\.env(?:\..*)?|env|composer\.(?:json|lock)|phpunit(?:\.dist)?\.xml|preload\.php|spark)$ - [F,L,NC]

    # Send the domain root directly to CodeIgniter's public front controller.
    RewriteRule ^$ public/index.php [L,QSA]

    # Requests already inside public are handled by public/.htaccess.
    RewriteRule ^public(?:/|$) - [L]

    # Expose public assets and route application URLs without moving files.
    RewriteRule ^(.*)$ public/$1 [L,QSA]
</IfModule>

<FilesMatch "^(?:\.env(?:\..*)?|env|composer\.(?:json|lock)|phpunit(?:\.dist)?\.xml|preload\.php|spark)$">
    Require all denied
</FilesMatch>

ServerSignature Off
